<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.LevelIndicatorQualityStatesDemo">
    <!-- 四个独立实例保存相同的 45%，只改变质量，方便对照“有值”和“值有效”的区别。
         WrapPanel 在宽度不足时自动换行；这些只是演示实例，没有复制组件实现代码。 -->
    <WrapPanel HorizontalAlignment="Center" ItemSpacing="16" LineSpacing="16">
        <arc:LevelIndicator Label="Good" Value="45" />
        <arc:LevelIndicator Label="NoData" Value="45" Quality="NoData" />
        <arc:LevelIndicator Label="Stale" Value="45" Quality="Stale" />
        <arc:LevelIndicator Label="Error" Value="45" Quality="Error" />
    </WrapPanel>
</UserControl>
